<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.CodeAnalysis.CSharp"
      Version="4.14.0"
    />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    // Include the project references from the src/ folder here.
  </ItemGroup>
  <Target
    Name="RecordProductionAssemblies"
    BeforeTargets="GetAssemblyAttributes"
  >
    <ItemGroup>
      <AssemblyMetadata
        Include="DddProductionAssembly"
        Value="%(ProjectReference.Filename)"
      />
    </ItemGroup>
  </Target>
</Project>
