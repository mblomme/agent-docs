{
  "description": "Format, analyze, and test the target .NET repository before completing a turn.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/adapters/hooks/codex/on_pre_tool_use.py\"",
            "timeout": 600,
            "statusMessage": "Running first-edit .NET quality checks."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/adapters/hooks/codex/on_agent_stop.py\"",
            "timeout": 600,
            "statusMessage": "Formatting, checking analyzers, and running tests."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/adapters/hooks/codex/on_user_prompt.py\"",
            "statusMessage": "Recording the .NET workspace baseline."
          }
        ]
      }
    ]
  }
}
